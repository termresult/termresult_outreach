# Public Firebase web config (safe in the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=termresult-outreach.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=termresult-outreach
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=termresult-outreach.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=219195820109
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Admin SDK
FIREBASE_ADMIN_PROJECT_ID=termresult-outreach
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Extra Google accounts that may sign in (comma-separated)
ALLOWLIST_EMAILS=officialtermresult@gmail.com

# Phase 01 Google sign-in is paused. Mock operator is on by default.
OUTREACH_MOCK_AUTH=1

# Twilio WhatsApp (Phase 04) — never NEXT_PUBLIC_
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_STATUS_CALLBACK_URL=
# Set to 1 only for Twilio sandbox free-form tests
TWILIO_WHATSAPP_SANDBOX=0
OUTREACH_TEST_PHONE=
